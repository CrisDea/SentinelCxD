{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Zscaler DNS Overview — ASIM parity\n\nNormalized Zscaler Internet Access telemetry delivered exclusively through Cribl. Lineage: `Azure/Azure-Sentinel` commit `cd455a8cecf3e5e983f9cd08191dca3d211c9fa1`, `Solutions/Zscaler Internet Access/Workbooks/NSSDNSLogs.json`. Vendor-specific values are read from documented `AdditionalFields` keys; select a time range and workspace below."
      },
      "name": "zia-dns-lineage"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "9eab10ba-966d-5eeb-a4a0-9ba37224cad7",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "940d3a8f-2218-5ae1-8dd8-12551ec26a5a",
            "version": "KqlParameterItem/1.0",
            "name": "Workspaces",
            "label": "Workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id,name",
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "zia-dns-parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_Dns\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSDNSlog'\n| summarize CountByTime=count() by bin(TimeGenerated,1h), DeviceEventClassID=EventType\n",
        "size": 0,
        "title": "DNS Events Over Time",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "timechart",
        "queryType": 0
      },
      "name": "zia-dns-panel-01-2c7913fe"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_Dns\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSDNSlog'\n| project EventTimestamp=TimeGenerated, SourceIP=SrcIpAddr, DestinationIP=DstIpAddr, DestinationPort=DstPortNumber, Action=EventResult, Severity=EventSeverity, UserName=SrcUsername, EventType\n| sort by EventTimestamp desc\n",
        "size": 0,
        "title": "DNS Event Details by Source and Destination",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "table",
        "queryType": 0
      },
      "name": "zia-dns-panel-02-445783ff"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_Dns\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSDNSlog'\n| summarize EventCount=count() by DeviceName=DvcHostname\n",
        "size": 0,
        "title": "Distribution of DNS Events by Device",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "barchart",
        "queryType": 0
      },
      "name": "zia-dns-panel-03-90d21cb9"
    }
  ],
  "fromTemplateId": "sentinel-ZIA-ASIM-dns",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}

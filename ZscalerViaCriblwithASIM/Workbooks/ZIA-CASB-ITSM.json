{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Zscaler CASB ITSM Overview — ASIM parity\n\nNormalized Zscaler Internet Access telemetry delivered exclusively through Cribl. Lineage: `Azure/Azure-Sentinel` commit `cd455a8cecf3e5e983f9cd08191dca3d211c9fa1`, `Solutions/Zscaler Internet Access/Workbooks/NSSCASBITSMLogs.json`. Vendor-specific values are read from documented `AdditionalFields` keys; select a time range and workspace below."
      },
      "name": "zia-casb-itsm-lineage"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "cc45249d-a4fd-50e3-88ea-7ac625cf4da8",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "3eb93c15-48ab-57b6-9a3d-93f4c1722854",
            "version": "KqlParameterItem/1.0",
            "name": "Workspaces",
            "label": "Workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id,name",
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "zia-casb-itsm-parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSCasbitsmlog'\n| extend Application=coalesce(tostring(column_ifexists('EventOriginalType','')), tostring(AdditionalFields['Application']))\n| summarize EventCount=count() by Application\n",
        "size": 0,
        "title": "Count of CASB ITSM Events by Application",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "barchart",
        "queryType": 0
      },
      "name": "zia-casb-itsm-panel-01-4c56b53d"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSCasbitsmlog'\n| summarize EventCount=count() by bin(TimeGenerated,1h)\n",
        "size": 0,
        "title": "CASB ITSM Events Over Time",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "timechart",
        "queryType": 0
      },
      "name": "zia-casb-itsm-panel-02-5cb176c5"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSCasbitsmlog'\n| project EventTimestamp=TimeGenerated, User=ActorUsername, Action=Operation, Identifier=tostring(AdditionalFields['Identifier'])\n| sort by EventTimestamp desc\n",
        "size": 0,
        "title": "CASB ITSM Detailed Security Event Information",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "table",
        "queryType": 0
      },
      "name": "zia-casb-itsm-panel-03-dcbddef1"
    }
  ],
  "fromTemplateId": "sentinel-ZIA-ASIM-casb-itsm",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}

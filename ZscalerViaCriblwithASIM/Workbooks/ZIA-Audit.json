{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Zscaler Admin Audit Overview — ASIM parity\n\nNormalized Zscaler Internet Access telemetry delivered exclusively through Cribl. Lineage: `Azure/Azure-Sentinel` commit `cd455a8cecf3e5e983f9cd08191dca3d211c9fa1`, `Solutions/Zscaler Internet Access/Workbooks/NSSAuditLogs.json`. Vendor-specific values are read from documented `AdditionalFields` keys; select a time range and workspace below."
      },
      "name": "zia-audit-lineage"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "72903d92-453f-5b6a-9e22-9d39801fe501",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "f089431c-7fcb-51fd-852f-3da27bdfeb01",
            "version": "KqlParameterItem/1.0",
            "name": "Workspaces",
            "label": "Workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id,name",
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "zia-audit-parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSAuditlog'\n| where isnotempty(ActorUsername)\n| summarize Count=count() by SourceUserName=ActorUsername, SourceIP=SrcIpAddr\n| order by Count desc\n",
        "size": 0,
        "title": "Access attempts by account name and IP address",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "table",
        "queryType": 0
      },
      "name": "zia-audit-panel-01-eac973b0"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSAuditlog'\n| where isnotempty(EventResult)\n| summarize Count=count() by EventOutcome=EventResult\n| order by Count desc\n",
        "size": 0,
        "title": "Login success and failures",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart",
        "graphSettings": {
          "type": 0,
          "topContent": {
            "columnMatch": "EventOutcome",
            "formatter": 1
          },
          "centerContent": {
            "columnMatch": "Count",
            "formatter": 1,
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          }
        },
        "mapSettings": {
          "locInfo": "LatLong",
          "sizeSettings": "Count",
          "sizeAggregation": "Sum",
          "legendMetric": "Count",
          "legendAggregation": "Sum",
          "itemColorSettings": {
            "type": "heatmap",
            "colorAggregation": "Sum",
            "nodeColorField": "Count",
            "heatmapPalette": "greenRed"
          }
        },
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "queryType": 0
      },
      "name": "zia-audit-panel-02-52330c3f"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_AuditEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSAuditlog'\n| where isnotempty(Operation)\n| summarize Count=count() by DeviceEventClassID=Operation\n| order by Count desc\n",
        "size": 0,
        "title": "Action carried out by user",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "unstackedbar",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "queryType": 0
      },
      "name": "zia-audit-panel-03-771bf52b"
    }
  ],
  "fromTemplateId": "sentinel-ZIA-ASIM-audit",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}

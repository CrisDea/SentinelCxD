{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Zscaler Endpoint DLP Overview — ASIM parity\n\nNormalized Zscaler Internet Access telemetry delivered exclusively through Cribl. Lineage: `Azure/Azure-Sentinel` commit `cd455a8cecf3e5e983f9cd08191dca3d211c9fa1`, `Solutions/Zscaler Internet Access/Workbooks/NSSEndpointDLPLogs.json`. Vendor-specific values are read from documented `AdditionalFields` keys; select a time range and workspace below."
      },
      "name": "zia-endpoint-dlp-lineage"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "fd55b1df-27fb-5d8c-be38-f5e57688202f",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "0fbc863c-d01b-5212-a115-4edac75e2787",
            "version": "KqlParameterItem/1.0",
            "name": "Workspaces",
            "label": "Workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id,name",
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "zia-endpoint-dlp-parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_FileEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSEndpointdlplog'\n| summarize Count=count() by DeviceEventClassID=EventType\n",
        "size": 0,
        "title": "Count of Security Events by Event Type",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "queryType": 0
      },
      "name": "zia-endpoint-dlp-panel-01-77d3bc67"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_FileEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSEndpointdlplog'\n| summarize EventCount=count() by bin(TimeGenerated,1h), DeviceEventClassID=EventType\n",
        "size": 0,
        "title": "Timeline of All Security Events",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "timechart",
        "queryType": 0
      },
      "name": "zia-endpoint-dlp-panel-02-1a256768"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "_Im_FileEvent\n| where TimeGenerated {TimeRange}\n| where EventVendor =~ 'Zscaler'\n| where EventProduct has 'ZIA'\n| where tostring(AdditionalFields['LogType']) =~ 'NSSEndpointdlplog'\n| project User=ActorUsername, EventType, Description=EventMessage, FilePath=TargetFilePath, TimeGenerated\n| sort by TimeGenerated desc\n",
        "size": 0,
        "title": "Detailed Event Table with User and Activity Information",
        "resourceType": "microsoft.operationalinsights/workspaces",
        "timeContextFromParameter": "TimeRange",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "visualization": "table",
        "queryType": 0
      },
      "name": "zia-endpoint-dlp-panel-03-78012a44"
    }
  ],
  "fromTemplateId": "sentinel-ZIA-ASIM-endpoint-dlp",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}

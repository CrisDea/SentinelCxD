{
  "version": "1.0.0",
  "rule": "For each canonical field, use the first non-empty source field. Values not consumed by these mappings are retained in AdditionalFields.",
  "matchSyntax": "A byFamily key ending in * is a prefix match; exact keys take precedence.",
  "common": {
    "TimeGenerated": ["TimeGenerated","datetime","eventtime","LogTimestamp","ModifiedTime","CreationTime"],
    "EventStartTime": ["EventStartTime","TimeGenerated","datetime","eventtime","TimestampConnectionStart","TimestampAuthentication"],
    "EventEndTime": ["EventEndTime","TimestampConnectionEnd","TimestampUnAuthentication","TimeGenerated"],
    "EventProduct": ["EventProduct","product"],
    "EventProductVersion": ["EventProductVersion","version","DeviceVersion"],
    "EventOriginalUid": ["EventOriginalUid","deviceExternalId","externalId","RequestID","ConnectionID","SessionID","NetworkSessionId"],
    "EventSeverity": ["EventSeverity","Severity","severity"],
    "EventOriginalSeverity": ["EventOriginalSeverity","Severity","severity"],
    "EventMessage": ["EventMessage","Message","_raw"],
    "EventResultDetails": ["EventResultDetails","outcome","reason","InternalReason","ConnectionStatus"],
    "SrcIpAddr": ["SrcIpAddr","src","SourceIP","ClientPublicIP","ClientPrivateIP"],
    "SrcPortNumber": ["SrcPortNumber","spt","SourcePort"],
    "SrcNatIpAddr": ["SrcNatIpAddr","sourceTranslatedAddress","SourceTranslatedAddress"],
    "SrcNatPortNumber": ["SrcNatPortNumber","sourceTranslatedPort","SourceTranslatedPort"],
    "SrcUsername": ["SrcUsername","suser","SourceUserName","Username","User","NameID"],
    "SrcHostname": ["SrcHostname","shost","SourceHostName","DvcHostname"],
    "DstIpAddr": ["DstIpAddr","dst","DestinationIP","ServerIP","ConnectorIP"],
    "DstPortNumber": ["DstPortNumber","dpt","DestinationPort","ServicePort","ServerPort","ApplicationPort"],
    "DstNatIpAddr": ["DstNatIpAddr","destinationTranslatedAddress","DestinationTranslatedAddress"],
    "DstNatPortNumber": ["DstNatPortNumber","destinationTranslatedPort","DestinationTranslatedPort"],
    "DstHostname": ["DstHostname","dhost","DestinationHostName","Host","Server"],
    "DstFQDN": ["DstFQDN","DstDomainHostname","UrlHostname","Hostname"],
    "DvcHostname": ["DvcHostname","dvchost","DeviceName","ClientZEN","ZEN"],
    "DvcIpAddr": ["DvcIpAddr","PrivateIP"],
    "NetworkProtocol": ["NetworkProtocol","proto","Protocol","IPProtocol"],
    "NetworkApplicationProtocol": ["NetworkApplicationProtocol","app","ApplicationProtocol"],
    "SrcBytes": ["SrcBytes","out_bytes","out","SentBytes","ZENTotalBytesRxClient","TotalBytesRx"],
    "DstBytes": ["DstBytes","in_bytes","inbytes","ReceivedBytes","ZENTotalBytesTxClient","TotalBytesTx"],
    "NetworkSessionId": ["NetworkSessionId","ConnectionID","SessionID"],
    "ActorUsername": ["ActorUsername","suser","SourceUserName","ModifiedBy","Username","User"]
  },
  "byFamily": {

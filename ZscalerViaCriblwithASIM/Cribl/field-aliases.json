      "ObjectId": ["deviceExternalId"]
    },
    "ZIA_CASB_*": {
      "EventType": ["act","name","Activity"],
      "Operation": ["act","name","Activity"],
      "EventResult": ["outcome","EventOutcome","act"],
      "TargetFilePath": ["filePath","FilePath","fname","FileName"],
      "TargetFileName": ["fname","FileName"],
      "TargetFileExtension": ["fileType","FileType"],
      "TargetFileSHA256": ["TargetFileSHA256"],
      "TargetFileSize": ["fsize","FileSize"],
      "TargetFileModificationTime": ["fileModificationTime","FileModificationTime"],
      "Object": ["fname","FileName","dhost","DestinationHostName"],
      "ObjectId": ["fileId","FileID","deviceExternalId"]
    },
    "ZIA_DNS": {
      "EventType": ["EventType"],
      "EventResult": ["EventResult"],
      "DnsQuery": ["DnsQuery","cs5","DeviceCustomString5"],

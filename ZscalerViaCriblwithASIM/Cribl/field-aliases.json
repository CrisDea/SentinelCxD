      "EventResult": ["EventResult","outcome"],
      "DvcAction": ["DvcAction","act","DeviceAction"],
      "Url": ["Url","request","RequestURL"],
      "UrlCategory": ["UrlCategory","cs2","DeviceCustomString2"],
      "HttpRequestMethod": ["HttpRequestMethod","requestMethod","RequestMethod"],
      "HttpStatusCode": ["HttpStatusCode","outcome","EventOutcome"],
      "HttpUserAgent": ["HttpUserAgent","requestClientApplication","RequestClientApplication"],
      "HttpReferrer": ["HttpReferrer","requestContext","RequestContext"],
      "ThreatName": ["ThreatName","cs5","DeviceCustomString5"],
      "TargetFileName": ["fname","FileName"],
      "TargetFileMD5": ["fileHash","FileHash","cs6","DeviceCustomString6"]
    },
    "ZPA/Access": {
      "EventType": ["EventType","ConnectionStatus"],
      "EventResult": ["EventResult","InternalReason","ConnectionStatus"],
      "DvcAction": ["DvcAction","ConnectionStatus","SessionStatus"],
      "TargetAppName": ["Application","AppGroup"],
      "NetworkDuration": ["NetworkDuration","ConnectionSetupTime"],
      "DstUsername": ["Username","User"]
    },
    "ZPA/Authentication": {
      "EventType": ["EventType","SessionType"],
      "EventResult": ["EventResult","SessionStatus","EventResultDetails"],
      "TargetUsername": ["TargetUsername","NameID","Username","User"],
      "ActorUsername": ["ActorUsername","NameID","Username","User"],
      "TargetAppName": ["TargetAppName","Idp","Application"],
      "AuthenticationProtocol": ["AuthenticationProtocol","Idp"]
    },
    "ZPA/Administration": {
      "EventType": ["EventType","AuditOperationType"],
      "Operation": ["Operation","AuditOperationType"],
      "EventResult": ["EventResult","EventResultDetails"],
      "ActorUsername": ["ActorUsername","ModifiedBy","Username","User"],
      "Object": ["Object","ObjectName"],
      "ObjectId": ["ObjectId","ObjectID"],
      "ObjectType": ["ObjectType"],
      "OldValue": ["OldValue","AuditOldValue"],
      "NewValue": ["NewValue","AuditNewValue"]
    }
  },
  "labelDrivenFields": {
    "pairs": [["cs1Label","cs1"],["cs2Label","cs2"],["cs3Label","cs3"],["cs4Label","cs4"],["cs5Label","cs5"],["cs6Label","cs6"],["cn1Label","cn1"],["cn2Label","cn2"],["cn3Label","cn3"]],
    "destination": "AdditionalFields"
  }

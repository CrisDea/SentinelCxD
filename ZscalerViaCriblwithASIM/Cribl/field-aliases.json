      "TargetFileName": ["fname","FileName"],
      "TargetFileExtension": ["fileType","FileType"],
      "TargetFileSHA256": ["TargetFileSHA256"]
    },
    "ZIA_Firewall": {
      "EventType": ["EventType"],
      "EventResult": ["EventResult","act"],
      "DvcAction": ["DvcAction","act","DeviceAction"],
      "NetworkDirection": ["deviceDirection","CommunicationDirection"],
      "NetworkDuration": ["cn1","DeviceCustomNumber1"],
      "ThreatCategory": ["cs5","DeviceCustomString5"],
      "ThreatName": ["cs6","DeviceCustomString6"]
